@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# TBoxFramework: tbox_sec_client 静态链接 framework-ipc（PRIVATE）。
# 静态库的 PRIVATE 依赖在最终链接时需由消费方解析，故声明 find_dependency。
# 调用方只面向 SEC 业务 facade，不直接使用 framework IPC 类型或 socket。
find_dependency(TboxFramework CONFIG)

# nlohmann_json: tbox_sec_client 内部使用（PRIVATE），公开头文件未引用，
# 但静态库导出目标仍会在链接时引用其符号。
find_dependency(nlohmann_json CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/TboxSecClientTargets.cmake")

check_required_components(TboxSecClient)
