[Unit]
Description=TBOX Security Service
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/bin/tbox_sec
Restart=on-failure
RestartSec=5
UMask=0077

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# 不启用 PrivateTmp：SEC 作为 client 连接 PROV 的 /tmp/tbox-prov.sock，并创建
# 自身 /tmp/tbox-sec.sock 供 MQTT 等连接。PrivateTmp 会隔离 /tmp，使 SEC 看不到
# PROV socket，prov_client 初始化失败 → initialize() 返回 false → 退出码 255。
ReadWritePaths=/var/tbox /var/log/tbox /tmp

# Resource limits
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
